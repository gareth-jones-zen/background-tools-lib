<Project Sdk="Microsoft.NET.Sdk">
  <!-- Running a tool quietly in the background on Windows: power requests, Task Scheduler, locks, the log, toasts.
       Windows only; anything that could run elsewhere belongs in another project. -->
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WinBackground.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Python's str.lower() for Locks.Key, so a lock name is the same as win_background's. -->
    <ProjectReference Include="..\PyCompat\PyCompat.csproj" />
  </ItemGroup>
</Project>
